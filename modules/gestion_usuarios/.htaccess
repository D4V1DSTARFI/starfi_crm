Options -Indexes
DirectoryIndex gestion_usuarios.php

<FilesMatch "^(modals_.*\.php|.*\.log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^back_usuarios\.php$ back_gestion_usuarios.php [L,QSA]
</IfModule>
