# ==========================================================
# STARFI CRM - Plantilla de Variables de Entorno (.env)
# Copie este archivo como .env y configure sus credenciales
# NUNCA versione el archivo .env real en Git
# ==========================================================

APP_ENV="PRODUCCION"

# Conexión principal a MySQL / MariaDB
DB_HOST="localhost"
DB_USER="your_db_user"
DB_PASS="your_db_password"
DB_NAME="starfi_crm"

# Meta WhatsApp Cloud API & Webhook
WEBHOOK_VERIFY_TOKEN="replace_with_random_verify_token"
META_GLOBAL_TOKEN="replace_with_meta_system_user_token"
META_APP_SECRET="replace_with_meta_app_secret"
META_API_VERSION="v23.0"

# Servidor central de respaldo multimedia (opcional)
CENTRAL_MEDIA_BASE_URL=""
