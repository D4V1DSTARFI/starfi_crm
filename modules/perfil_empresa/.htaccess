Options -Indexes
DirectoryIndex perfil_empresa.php

<FilesMatch "^(modals_.*\.php|.*\.log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^back_empresa\.php$ back_perfil_empresa.php [L,QSA]
</IfModule>
