# STARFI CRM - Blindaje de Directorios y Archivos Sensibles (SEC-04)
Options -Indexes

# Bloquear acceso directo a archivos sensibles (.env, dumps SQL, logs, binarios)
<FilesMatch "(^\.env|^\.git|\.(sql|log|exe|ini|bak|sh)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Bloquear navegación directa a carpetas internas
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(logs|config|core|database|\.git)(/|$) - [F,L]
</IfModule>
