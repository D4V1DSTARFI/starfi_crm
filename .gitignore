# Archivos de entorno y secretos
.env
.env.*
!.env.example
config/.env*
config/.enable_installer
assets/uploads/.env*

# Bloqueo estricto de volcados SQL y artefactos residuales (solo se versiona database/database_schema.sql limpio)
/*.sql
/database/*.sql
!/database/database_schema.sql
/database/dummy_data.sql
/database/install_dumps/
*.resolved

# Archivos multimedia y documentos confidenciales subidos (preservando .htaccess y .gitkeep)
assets/uploads/*
!assets/uploads/.htaccess
!assets/uploads/comprobantes_waba/
assets/uploads/comprobantes_waba/*
!assets/uploads/comprobantes_waba/.htaccess
uploads/*
!uploads/.htaccess
!uploads/expedientes/
uploads/expedientes/*
!uploads/expedientes/.htaccess
!uploads/documentos/
uploads/documentos/*
!uploads/documentos/.htaccess
assets/docs/expedientes/*
!assets/docs/expedientes/.htaccess
!assets/docs/expedientes/.gitkeep

# Binarios pesados/externos
cloudflared.exe
*.exe

# Registros locales por módulo y globales
logs/*
!logs/.htaccess
modules/*/logs_*.log
*.log

# Directorios y scripts temporales de prueba en raíz ([OMN-04])
scratch/
/scratch_*.php
/test*.php
/tmp_*.php
/debug_*.php
/dump_*.php
/export_databases.php
/print_all_rows.php
*.bak
*.tmp
