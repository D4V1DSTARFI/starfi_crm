Options -Indexes

# Bloquear ejecución de scripts y lectura de archivos ocultos/.env dentro de uploads
<FilesMatch "(^\.env|\.(php|php5|php7|phtml|phar|ini|sql|log|sh|bak)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
