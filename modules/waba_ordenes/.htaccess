Options -Indexes
DirectoryIndex waba_ordenes.php

<FilesMatch "^(modals_.*\.php|.*\.log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^imprimir_orden_waba\.php$ ../../imprimir_orden_waba.php [L,QSA]
</IfModule>
